---
import Base from "@/layouts/Base.astro";
import { languages, getDictionary, isLang } from "@/i18n/utils";
import Logo from "@/components/ui/Logo.astro";
import Badge from "@/components/ui/Badge.astro";
import Chip from "@/components/ui/Chip.astro";
import LangSwitch from "@/components/ui/LangSwitch.astro";

export function getStaticPaths() {
    return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isLang(lang)) throw new Error(`Idioma no soportado: ${lang}`);

const t = getDictionary(lang);
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
    <h1>{t.hero.title}</h1>
    <p>{t.hero.subtitle}</p>
    <Logo />
    <Badge text={t.hero.status} />
    <Chip
        title={t.hero.chips.session.label}
        text={t.hero.chips.session.value}
    />
    <LangSwitch lang={lang} label={t.nav.langSwitchLabel} />
</Base>
