---
import { getRelativeLocaleUrl } from "astro:i18n";
import { languages, type Lang } from "@/i18n/utils";

interface Props {
    lang: Lang;
    label: string;
}

const { lang, label } = Astro.props;
---

<nav class="lang-switch" aria-label={label}>
    {Object.entries(languages).map(([code, name], index) => (
        <Fragment>
            {index > 0 && <span aria-hidden="true">/</span>}
            <a
                href={getRelativeLocaleUrl(code)}
                class:list={[{ active: code === lang }]}
                aria-current={code === lang ? "page" : undefined}
            >
                {name}
            </a>
        </Fragment>
    ))}
</nav>
<style lang="scss">
    @use "../../styles/typography" as *;
    .lang-switch {
        @include ui;
        display: inline-flex;
        justify-content: space-between;
        align-items: center;
        color: var(--text-grey);
        gap: var(--spacing-xs);
        padding: var(--spacing-xs) var(--spacing-sm);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-pill);
    }
    .active {
        color: var(--text-sea-mist);
    }
</style>
