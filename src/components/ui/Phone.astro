---
interface Props {
    placeholder: string;
}

const { placeholder } = Astro.props;
---

<div class="phone">
    <span class="placeholder">{placeholder}</span>
</div>

<style lang="scss">
    @use "../../styles/typography" as *;

    .phone {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 300px;
        height: 650px;
        background-color: var(--bg-night-sea);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-xl);
    }

    .placeholder {
        @include ui;
        color: var(--text-grey);
    }
</style>
